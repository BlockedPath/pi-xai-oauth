#!/usr/bin/env bash
# Prepares an Amp orb for pi-xai-oauth: pins CI's npm resolver and installs
# the locked development dependencies. Idempotent and non-interactive.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  local label="$1"
  shift
  local start=$SECONDS
  echo "==> $label"
  "$@"
  echo "<== $label ($((SECONDS - start))s)"
}

# Pi peers require Node >=22.19.0; the orb base image ships a newer Node.
check_node() {
  node -e '
    const [major, minor] = process.versions.node.split(".").map(Number);
    if (major < 22 || (major === 22 && minor < 19)) {
      console.error(`Node ${process.versions.node} is older than the required 22.19.0`);
      process.exit(1);
    }
    console.log(`node ${process.versions.node}`);
  '
}

# CI pins the npm resolver because peer resolution differs across npm majors.
# Read the version from the workflow so it has a single source of truth.
pin_npm() {
  local wanted current
  wanted="$(sed -n 's/^[[:space:]]*NPM_VERSION:[[:space:]]*"\{0,1\}\([0-9.]*\)"\{0,1\}[[:space:]]*$/\1/p' .github/workflows/ci.yml | head -n1)"
  if [[ -z "$wanted" ]]; then
    echo "Could not read NPM_VERSION from .github/workflows/ci.yml" >&2
    return 1
  fi
  current="$(npm --version)"
  if [[ "$current" == "$wanted" ]]; then
    echo "npm $current already pinned"
  else
    echo "npm $current -> $wanted"
    npm install --global --no-audit --no-fund "npm@$wanted"
  fi
}

install_deps() {
  npm ci --strict-peer-deps --no-audit --no-fund
}

step "Check Node version" check_node
step "Pin npm resolver" pin_npm
step "Install locked dependencies" install_deps
